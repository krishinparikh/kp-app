FROM node:24-alpine

# Pin pnpm to the version that produced the lockfile.
RUN npm install -g pnpm@11.10.0

WORKDIR /repo

# Workspace manifests first so this layer caches across source edits. Every
# workspace member's package.json has to be present or --frozen-lockfile sees a
# mismatch against the root lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY apps/landing/package.json apps/landing/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter server...

# The shared package has to be compiled before the server can import it: it
# runs plain node on its own dist and has no TypeScript loader. .dockerignore
# excludes **/dist, so it's built here rather than copied in.
COPY packages/shared packages/shared
RUN pnpm --filter @kp-app/shared build

COPY apps/server apps/server

WORKDIR /repo/apps/server

EXPOSE 8000

# Recompile the bind-mounted shared source, leave a tsc watch running behind
# it, then hand PID 1 to nest.
CMD ["sh", "-c", "pnpm --filter @kp-app/shared build && (pnpm --filter @kp-app/shared dev &) && exec pnpm dev"]
