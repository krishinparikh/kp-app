FROM node:24-alpine

# Pin pnpm to the version that produced the lockfile.
RUN npm install -g pnpm@11.10.0

WORKDIR /repo

# Workspace manifests first so this layer caches across source edits. Every
# workspace member's package.json has to be present or --frozen-lockfile sees a
# mismatch against the root lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/contract/package.json packages/contract/
RUN pnpm install --frozen-lockfile --filter server...

# The contract has to be compiled before the server can import it: the server
# runs plain node on its own dist and has no TypeScript loader. .dockerignore
# excludes **/dist, so it's built here rather than copied in.
COPY packages/contract packages/contract
RUN pnpm --filter @kp-app/contract build

COPY apps/server apps/server

WORKDIR /repo/apps/server

EXPOSE 8000

# Recompile the bind-mounted contract source, leave a tsc watch running behind
# it, then hand PID 1 to nest.
CMD ["sh", "-c", "pnpm --filter @kp-app/contract build && (pnpm --filter @kp-app/contract dev &) && exec pnpm dev"]
