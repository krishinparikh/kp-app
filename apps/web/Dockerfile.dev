FROM node:24-alpine

# Pin pnpm to the version that produced the lockfile.
RUN npm install -g pnpm@11.10.0

WORKDIR /repo

# Workspace manifests first so this layer caches across source edits. Every
# workspace member's package.json has to be present or --frozen-lockfile sees a
# mismatch against the root lockfile.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/server/package.json apps/server/
COPY apps/landing/package.json apps/landing/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --frozen-lockfile --filter web...

# Vite resolves @kp-app/shared through its exports map to dist/, so it is
# compiled here too. Each image owns its own dist.
COPY packages/shared packages/shared
RUN pnpm --filter @kp-app/shared build

# @kp-app/ui ships source, so there is nothing to build — Vite compiles it.
COPY packages/ui packages/ui

COPY apps/web apps/web

WORKDIR /repo/apps/web

EXPOSE 5173

# Recompile the bind-mounted shared source, leave a tsc watch running behind
# it, then hand PID 1 to Vite. `--host` comes from vite.config.ts.
CMD ["sh", "-c", "pnpm --filter @kp-app/shared build && (pnpm --filter @kp-app/shared dev &) && exec pnpm dev"]
