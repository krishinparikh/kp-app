{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // The App Router's own convention: a route file exports `metadata` and
      // `viewport` next to its component. The fast-refresh rule can't see that.
      "files": [
        "src/app/**/{layout,page,template,error,loading,not-found}.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
