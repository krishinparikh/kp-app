# Copy to .env and adjust as needed. This single root file feeds three consumers:
#   1. docker-compose.yml  — ${VAR} interpolation (only reads THIS file)
#   2. packages/backend    — pydantic-settings, via env_file="../../.env"
#   3. packages/frontend   — Vite, via envDir: '../../' (VITE_* vars only)

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Host ports. Change these if something else already listens on them.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Used when running the backend natively (outside compose). Inside compose this
# is overridden to point at the `db` service instead of localhost.
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
CORS_ORIGINS=["http://localhost:5173"]

# Only VITE_-prefixed vars reach the browser bundle.
VITE_API_URL=http://localhost:8000
