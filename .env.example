# Copy to .env and adjust as needed. This single root file feeds three consumers:
#   1. docker-compose.yml  — ${VAR} interpolation (only reads THIS file)
#   2. apps/server         — @nestjs/config, via envFilePath: '../../.env'
#   3. apps/web            — Vite, via envDir: '../../' (VITE_* vars only)

POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Host ports. Change these if something else already listens on them.
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Used when running the server natively (outside compose). Inside compose this
# is overridden to point at the `db` service instead of localhost.
DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
CORS_ORIGINS=["http://localhost:5173"]

# Only VITE_-prefixed vars reach the browser bundle.
#
# Server the web app talks to. Exactly one of these should be uncommented —
# Vite reads VITE_API_URL, so the last definition wins if both are active.
# Local dev (server on the host, or published from compose):
VITE_API_URL=http://localhost:8000
# Deployed server — swap in the real host and comment out the line above:
# VITE_API_URL=https://api.example.com
